    <granularAccess xmlns="http://www.riik.ee/schemas/deccontainer/vers_2_1/granularAccess/">
      <!--
        File Ettepanek.doc is restricted as a whole: its Access is "AK", never
        more permissive than the document-level Access above it. An application
        that understands file-level access but cannot segment the file therefore
        withholds the whole file, which is safe.

        An application that recognises the SegmentationMethod value may go
        further. DefaultPartAccessConditionsCode says that any part of this file
        not covered by an AccessGroup below is in fact "Avalik", so only the
        restricted islands need to be enumerated — there is no need to list every
        public paragraph. Those islands are paragraphs 3-4 and a single word
        elsewhere in the file (word 42, e.g. a personal identification code
        mentioned in passing in an otherwise public paragraph). Since they carry
        the identical access condition and restriction, they are listed together
        under one AccessGroup, so the Access/AccessRestriction data only needs to
        be written once instead of being repeated per range. Note that the word
        range is independent of the paragraph range and does not require the
        paragraph containing it to be listed. Word and paragraph numbering both
        follow SegmentationMethod.
      -->
      <File>
        <FileGuid>25892e17-80f6-415f-9c65-7395632f0001</FileGuid>
        <Access>
          <AccessConditionsCode>AK</AccessConditionsCode>
          <AccessRestriction>
            <RestrictionIdentifier>AvTS§35p1p11</RestrictionIdentifier>
            <RestrictionBeginDate>2012-11-11</RestrictionBeginDate>
            <RestrictionEndDate>2017-11-11</RestrictionEndDate>
