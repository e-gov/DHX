            <InformationOwner>Riigi Infosüsteemi Amet</InformationOwner>
          </AccessRestriction>
        </Access>
        <SegmentationMethod>whitespace-split-v1</SegmentationMethod>
        <DefaultPartAccessConditionsCode>Avalik</DefaultPartAccessConditionsCode>
